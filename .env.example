# MySQL 8 本地开发凭据。真实部署请使用强密码和独立的密钥管理。
MYSQL_USER=youshu
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
MYSQL_HOST_PORT=3307

# 地图服务：MAP_PROVIDER 指定启用的服务商（当前内置 tencent）
MAP_PROVIDER=tencent
TENCENT_MAP_KEY=
TENCENT_MAP_SECRET_KEY=

# 前端底图服务商与 JS API Key（可选，默认已内置演示 Key）
VITE_MAP_PROVIDER=tencent
VITE_TENCENT_MAP_KEY=
