{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-nova",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src-react/index.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {
    "@magicui": {
      "url": "https://magicui.design/r/{name}.json"
    },
    "@kokonutui": {
      "url": "https://kokonutui.com/r/{name}.json"
    },
    "@coss": {
      "url": "https://coss.com/ui/r/{name}.json"
    },
    "@tailark-oss": {
      "url": "https://oss.tailark.com/r/{name}.json"
    }
  }
}
